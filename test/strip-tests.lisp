(fiasco:define-test-package #:mahogany-tests/strip
  (:local-nicknames (#:tree #:mahogany/tree))
  (:use #:mahogany/util
        #:mahogany/wm-interface
        #:mahogany/test/util))

(in-package #:mahogany-tests/strip)

;;; A fake heart that remembers what was asked of it: each border box and each
;;; view gets its own pointer, so the tests can read back a cell's border state
;;; and a window's geometry.

(defvar *next-pointer*)
(defvar *box-enabled*)
(defvar *view-position*)
(defvar *view-size*)
(defvar *view-hidden*)

(defun %fresh-pointer ()
  (cffi:make-pointer (incf *next-pointer*)))

(defun %key (pointer)
  (cffi:pointer-address pointer))

(defmacro with-fake-heart ((&key (width 1000) (height 500)) &body body)
  `(let ((*next-pointer* 4096)
         (*box-enabled* (make-hash-table))
         (*view-position* (make-hash-table))
         (*view-size* (make-hash-table))
         (*view-hidden* (make-hash-table)))
     (cl-mock:dflet ((hrt:output-position (output)
                       (declare (ignore output))
                       (values 0 0))
                     (hrt:output-resolution (output)
                       (declare (ignore output))
                       (values ,width ,height))
                     (hrt::border-box-create (layer style x y w h)
                       (declare (ignore layer style x y w h))
                       (let ((box (%fresh-pointer)))
                         (setf (gethash (%key box) *box-enabled*) t)
                         box))
                     (hrt:hrt-border-box-set-enabled (box enabled)
                       (setf (gethash (%key box) *box-enabled*) enabled))
                     (hrt:hrt-border-box-set-relative (box x y)
                       (declare (ignore box x y)))
                     (hrt:hrt-border-box-set-size (box w h)
                       (declare (ignore box w h)))
                     (hrt:hrt-border-box-destroy (box)
                       (declare (ignore box)))
                     (hrt:hrt-border-box-lower-to-bottom (box)
                       (declare (ignore box)))
                     (hrt:hrt-border-box-raise-to-top (box)
                       (declare (ignore box)))
                     (hrt:border-box-set-style (box style)
                       (declare (ignore box style)))
                     (hrt::hrt-view-set-size (view w h)
                       (setf (gethash (%key view) *view-size*) (list w h))
                       0)
                     (hrt::hrt-view-set-relative (view x y)
                       (setf (gethash (%key view) *view-position*) (list x y)))
                     (hrt::hrt-view-set-hidden (view hidden)
                       (setf (gethash (%key view) *view-hidden*) hidden))
                     (hrt::hrt-view-set-suspended (view suspended)
                       (declare (ignore view suspended)))
                     (hrt:focus-view (view seat)
                       (declare (ignore view seat)))
                     (hrt:unfocus-view (view seat)
                       (declare (ignore view seat)))
                     (hrt::%commit-view-transaction ()))
       ,@body)))

(defun make-strip (&key (reserved-top 20))
  (let* ((container (make-instance 'tree:layer-container
                                   :hrt-layer (cffi:null-pointer)))
         (output (make-instance 'tree:output-container
                                :output (make-mock-output))))
    (multiple-value-bind (node strip) (tree:tree-output-add-strip container output)
      (declare (ignore node))
      (setf (tree:strip-reserved-top strip) reserved-top)
      strip)))

(defun add-window (strip)
  (let ((view (make-mock-view (%fresh-pointer))))
    (values (tree:strip-add-view strip view) view)))

(defun border-on-p (cell)
  (gethash (%key (slot-value cell 'tree::border-box)) *box-enabled*))

(defun view-box (view)
  "The window's (x y width height) as last sent to heart."
  (append (gethash (%key (hrt::view-hrt-view view)) *view-position*)
          (gethash (%key (hrt::view-hrt-view view)) *view-size*)))

(defun focus (cell)
  (tree:mark-frame-focused cell (cffi:null-pointer)))

(defun fullscreen (cell on)
  (setf (tree:cell-fullscreen cell) on)
  (tree:strip-layout (tree:frame-parent cell)))

;;; Output 1000x500, bar 20, gap 16: the area between the gaps starts at
;;; (16, 36) and is 968x448; a half-width column is 476 pixels wide.

(fiasco:deftest strip-fullscreen-fills-the-output-when-selected ()
  (with-fake-heart ()
    (let ((strip (make-strip)))
      (add-window strip)
      (multiple-value-bind (cell view) (add-window strip)
        (focus cell)
        (fullscreen cell t)
        (is (equal (view-box view) '(0 0 1000 500)))
        (is (not (border-on-p cell)))))))

(fiasco:deftest strip-fullscreen-slides-aside-for-a-neighbour ()
  (with-fake-heart ()
    (let ((strip (make-strip)))
      (multiple-value-bind (left left-view) (add-window strip)
        (multiple-value-bind (cell view) (add-window strip)
          (focus cell)
          (fullscreen cell t)
          (focus left)
          ;; The neighbour is where a selected left column goes...
          (is (= (tree:frame-x left) 16))
          (is (equal (view-box left-view) '(17 37 474 446)))
          (is (border-on-p left))
          ;; ...and the fullscreen window keeps the whole output's size and
          ;; height, bar included, one gap to its right.
          (is (equal (view-box view) '(508 0 1000 500)))
          (is (tree::cell-shown cell))
          (is (not (border-on-p cell)))
          ;; Back to it: lined up with the output again, the neighbour gone.
          (focus cell)
          (is (equal (view-box view) '(0 0 1000 500)))
          (is (not (tree::cell-shown left))))))))

(fiasco:deftest strip-fullscreen-focus-never-draws-a-border ()
  ;; The view-frame focus method turns the border on; a fullscreen window
  ;; must not show it, before or after any number of focus changes.
  (with-fake-heart ()
    (let ((strip (make-strip)))
      (multiple-value-bind (left) (add-window strip)
        (multiple-value-bind (cell) (add-window strip)
          (focus cell)
          (fullscreen cell t)
          (dotimes (i 3)
            (focus left)
            (tree:unmark-frame-focused left (cffi:null-pointer))
            (focus cell)
            (is (not (border-on-p cell))))
          (tree:unmark-frame-focused cell (cffi:null-pointer))
          (is (not (border-on-p cell))))))))

(fiasco:deftest strip-unfullscreen-restores-column-and-border ()
  (with-fake-heart ()
    (let ((strip (make-strip)))
      (add-window strip)
      (multiple-value-bind (cell view) (add-window strip)
        (focus cell)
        (fullscreen cell t)
        (fullscreen cell nil)
        (is (border-on-p cell))
        (is (= (tree:frame-x cell) 16))
        (is (equal (view-box view) '(17 37 474 446)))))))

(fiasco:deftest strip-fullscreen-column-shows-one-window ()
  (with-fake-heart ()
    (let ((strip (make-strip)))
      (multiple-value-bind (top) (add-window strip)
        (multiple-value-bind (bottom bottom-view) (add-window strip)
          (focus top)
          (tree:strip-consume strip)
          (focus bottom)
          (fullscreen bottom t)
          (is (equal (view-box bottom-view) '(0 0 1000 500)))
          (is (not (tree::cell-shown top)))
          (is (tree:cell-covered-p strip top))
          (is (null (tree:strip-focus-target strip :up)))
          (is (null (tree:strip-focus-target strip :down)))
          ;; Leaving the column and coming back lands on the fullscreen window.
          (multiple-value-bind (other) (add-window strip)
            (focus other)
            (is (eq (tree:strip-focus-target strip :left) bottom))))))))

(fiasco:deftest strip-fullscreen-survives-column-moves ()
  (with-fake-heart ()
    (let ((strip (make-strip))
          (other (make-strip)))
      (multiple-value-bind (cell view) (add-window strip)
        (focus cell)
        (fullscreen cell t)
        (multiple-value-bind (views width fullscreen)
            (tree:strip-take-column strip (tree:cell-column strip cell))
          (is (eq fullscreen view))
          (let ((moved (tree:strip-add-column other views width :fullscreen fullscreen)))
            (is (tree:cell-fullscreen moved))
            (is (equal (view-box view) '(0 0 1000 500)))
            (is (not (border-on-p moved)))))))))
